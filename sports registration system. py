            else:

                data[key] = widget.get().strip()

        return data

    # ======================================================
    # VALIDATE FORM
    # ======================================================

    def validate_form(self, data):

        required = [
            "player_name",
            "age",
            "gender",
            "sport",
            "category",
            "phone",
            "email",
            "college",
            "registration_date"
        ]

        for field in required:

            if not data[field]:

                messagebox.showwarning(
                    "Validation",
                    "Please fill all fields."
                )

                return False

        if not valid_age(
            data["age"]
        ):

            messagebox.showwarning(
                "Validation",
                "Age must be a number between 5 and 100."
            )

            return False

        if not valid_phone(
            data["phone"]
        ):

            messagebox.showwarning(
                "Validation",
                "Phone number must contain exactly 10 digits."
            )

            return False

        if not valid_email(
            data["email"]
        ):

            messagebox.showwarning(
                "Validation",
                "Please enter a valid email."
            )

            return False

        # Date format validation
        try:

            date.fromisoformat(
                data["registration_date"]
            )

        except ValueError:

            messagebox.showwarning(
                "Validation",
                "Date must be in YYYY-MM-DD format."
            )

            return False

        return True

