    def load_records(self):

        for item in self.tree.get_children():

            self.tree.delete(item)

        conn = None
        cursor = None

        try:

            conn = get_db_connection()

            cursor = conn.cursor()

            # SELECT
            cursor.execute("""
                SELECT
                    id,
                    player_name,
                    age,
                    gender,
                    sport,
                    category,
                    phone,
                    email,
                    college,
                    registration_date
                FROM players
                ORDER BY id DESC
            """)

            rows = cursor.fetchall()

            for row in rows:

                self.tree.insert(
                    "",
                    tk.END,
                    values=row
                )

        except Error as e:

            messagebox.showerror(
                "Database Error",
                str(e)
            )

        finally:

            if cursor:
                cursor.close()

            if conn:
                conn.close()

    # ======================================================
    # UPDATE PLAYER
    # ======================================================

    def update_selected(self):

        selected = self.tree.selection()

        if not selected:

            messagebox.showwarning(
                "Update",
                "Please select a player."
            )

            return

        values = self.tree.item(
            selected[0],
            "values"
        )

        self.selected_id = values[0]

        self.show_update_form(
            values
        )

    def show_update_form(self, values):

        self.create_form_page(
            "Update Player Registration",
            "Update Record",
            self.update_record
        )

        mapping = [
            ("player_name", values[1]),
            ("age", values[2]),
            ("gender", values[3]),
            ("sport", values[4]),
            ("category", values[5]),
            ("phone", values[6]),
            ("email", values[7]),
            ("college", values[8]),
            ("registration_date", values[9])
        ]

        for key, value in mapping:

            if key == "gender":

                self.gender_var.set(
                    value
                )

            else:

                widget = self.entries[key]

                if isinstance(
                    widget,
                    ttk.Combobox
                ):

                    widget.set(
                        value
                    )

                else:

                    widget.insert(
                        0,
                        value
                    )

    def update_record(self):

        if not self.selected_id:

            messagebox.showwarning(
                "Update",
                "No player selected."
            )

            return

        data = self.get_form_values()

        if not self.validate_form(data):
            return

        conn = None
        cursor = None

        try:

            conn = get_db_connection()

            cursor = conn.cursor()

            # UPDATE + WHERE
            cursor.execute("""
                UPDATE players
                SET
                    player_name=%s,
                    age=%s,
                    gender=%s,
                    sport=%s,
                    category=%s,
                    phone=%s,
                    email=%s,
                    college=%s,
                    registration_date=%s
                WHERE id=%s
            """, (
                data["player_name"],
                int(data["age"]),
                data["gender"],
                data["sport"],
                data["category"],
                data["phone"],
                data["email"],
                data["college"],
                data["registration_date"],
                self.selected_id
            ))

            conn.commit()

            messagebox.showinfo(
                "Success",
                "Player record updated successfully."
            )

            self.show_view()

        except Error as e:

            messagebox.showerror(
                "Database Error",
                str(e)
            )

        finally:

            if cursor:
                cursor.close()

            if conn:
                conn.close()

    # ======================================================
    # DELETE PLAYER
    # ======================================================

    def delete_selected(self):

        selected = self.tree.selection()

        if not selected:

            messagebox.showwarning(
                "Delete",
                "Please select a player."
            )

            return

        values = self.tree.item(
            selected[0],
            "values"
        )

        player_id = values[0]
        player_name = values[1]

        confirm = messagebox.askyesno(
            "Confirm Delete",
            f"Are you sure you want to delete "
            f"'{player_name}'?"
        )

        if not confirm:
            return

        conn = None
        cursor = None

        try:

            conn = get_db_connection()

            cursor = conn.cursor()

            # DELETE + WHERE
            cursor.execute(
                "DELETE FROM players WHERE id=%s",
                (player_id,)
            )

            conn.commit()

            messagebox.showinfo(
                "Deleted",
                "Player deleted successfully."
            )

            self.load_records()

        except Error as e:

            messagebox.showerror(
                "Database Error",
                str(e)
            )

        finally:

            if cursor:
                cursor.close()

            if conn:
                conn.close()

