    # ======================================================
    # DASHBOARD STATISTICS
    # ======================================================

    def get_stats(self):

        conn = None
        cursor = None

        try:

            conn = get_db_connection()

            cursor = conn.cursor()

            # Total players
            cursor.execute(
                "SELECT COUNT(*) FROM players"
            )

            total_players = cursor.fetchone()[0]

            # Different sports
            cursor.execute(
                "SELECT COUNT(DISTINCT sport) FROM players"
            )

            sports_count = cursor.fetchone()[0]

            # Male
            cursor.execute(
                "SELECT COUNT(*) FROM players WHERE gender='Male'"
            )

            male_count = cursor.fetchone()[0]

            # Female
            cursor.execute(
                "SELECT COUNT(*) FROM players WHERE gender='Female'"
            )

            female_count = cursor.fetchone()[0]

            return (
                total_players,
                sports_count,
                male_count,
                female_count
            )

        except Error:

            return 0, 0, 0, 0

        finally:

            if cursor:
                cursor.close()

            if conn:
                conn.close()

