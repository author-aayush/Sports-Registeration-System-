    # ADD PLAYER
    # ======================================================

    def show_add(self):

        self.create_form_page(
            "Add Player Registration",
            "Save Registration",
            self.add_record
        )

    def add_record(self):

        data = self.get_form_values()

        if not self.validate_form(data):
            return

        conn = None
        cursor = None

        try:

            conn = get_db_connection()

            cursor = conn.cursor()

            # INSERT
            cursor.execute("""
                INSERT INTO players
                (
                    player_name,
                    age,
                    gender,
                    sport,
                    category,
                    phone,
                    email,
                    college,
                    registration_date
                )
                VALUES
                (%s, %s, %s, %s, %s, %s, %s, %s, %s)
            """, (
                data["player_name"],
                int(data["age"]),
                data["gender"],
                data["sport"],
                data["category"],
                data["phone"],
                data["email"],
                data["college"],
                data["registration_date"]
            ))

            conn.commit()

            messagebox.showinfo(
                "Success",
                "Player registered successfully."
            )

            self.clear_form()

        except Error as e:

            messagebox.showerror(
                "Database Error",
                str(e)
            )

        finally:

            if cursor:
                cursor.close()

            if conn:
                conn.close()

